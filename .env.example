# =============================================================================
#  XBZ Web — variables d'environnement
#
#  Copie ce fichier en `.env.local` et remplis les valeurs :
#      cp .env.example .env.local
#
#  Priorité de lecture par Next.js (la dernière gagne) :
#      .env  <  .env.local
#  → `.env.local` est ignoré par git : c'est LÀ que vont les vraies valeurs.
#
#  En production, ces variables se règlent dans Vercel › Settings › Environment
#  Variables (ce fichier n'y est pas lu).
#
#  ⚠️  Une variable NEXT_PUBLIC_* est envoyée au NAVIGATEUR : jamais de secret.
#      Une variable sans ce préfixe reste côté serveur.
#
#  Le test `src/lib/env.test.ts` vérifie que toute variable utilisée dans le
#  code est bien documentée ici.
# =============================================================================


# === Site (obligatoire) ======================================================
# Domaine de production, SANS slash final. Sert au sitemap, aux canonicals,
# au JSON-LD et aux images Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.xbz-esport.org

# Invitation Discord publique (liens « Rejoindre », pages légales).
# Absente → les liens deviennent du texte simple, rien ne casse.
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/xxxxxxxxxx

# (L'adresse de contact n'est plus une variable : elle est dans src/lib/legal.ts,
# avec le reste de l'identité légale — CGV, mentions légales, confidentialité.)


# === Supabase (obligatoire) ==================================================
# Projet › Settings › API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Clé publique (lecture soumise à la RLS) — exposée au navigateur, c'est normal.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Clé service_role — SECRET ABSOLU. Contourne la RLS : back-office, écritures
# des formulaires, purge RGPD. Ne jamais préfixer NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx


# === Boutique / Stripe (obligatoire pour vendre en ligne) ====================
# Paiement par Checkout hébergé : le client paie sur une page Stripe. Aucune
# clé n'atteint le navigateur (pas de NEXT_PUBLIC_*). Sans LES DEUX variables
# ci-dessous, la boutique reste un aperçu : rien ne peut être mis au panier.
#
# Clé secrète — Stripe › Développeurs › Clés API. SECRET : jamais de préfixe
# NEXT_PUBLIC_. Clé de TEST (sk_test_…) pour essayer, clé live (sk_live_…) une
# fois le compte Stripe activé ET les obligations légales en place : avec une clé
# live, le paiement est REFUSÉ (503, panier « bientôt ») tant que src/lib/legal.ts
# n'a pas de médiateur de la consommation ni de numéro de téléphone et que la
# rétractation en ligne n'est pas livrée. La liste de ce qui manque est écrite dans
# les journaux (« paiement live refusé »).
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# Secret de signature du webhook — Stripe › Développeurs › Webhooks › Ajouter
# un endpoint : https://www.xbz-esport.org/api/stripe/webhook, événements
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed, checkout.session.expired,
#   charge.refunded
# C'est lui qui prouve qu'un appel vient bien de Stripe ; il confirme les
# ventes et rend le stock des paiements abandonnés. Un secret par mode (test/live).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Frais de port par commande, en euros (facultatif — défaut 4.90).
SHIPPING_FLAT_EUR=4.90

# Webhook du salon Discord prévenu à chaque commande payée (facultatif).
# Le message liste articles et montant, sans nom ni adresse du client.
DISCORD_COMMANDES_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# TESTS LOCAUX UNIQUEMENT : adresse d'un faux Stripe (ex. http://localhost:12111).
# Ignorée en production. À laisser vide.
STRIPE_MOCK_URL=


# === E-mails de la boutique (obligatoire pour les vrais paiements) ===========
# Accusé de réception de la rétractation en ligne (« Renoncer au contrat ici »),
# envoyé au client avec le contenu de sa déclaration, la date et l'heure : la loi
# l'exige depuis le 19 juin 2026. Fournisseur : Brevo (société française, données
# en Europe, 300 e-mails/jour gratuits), par son API HTTPS.
#
# Brevo › SMTP & API › Clés API. SECRET : jamais de préfixe NEXT_PUBLIC_.
# Le domaine de l'expéditeur doit être AUTHENTIFIÉ chez Brevo (enregistrements
# DNS SPF, DKIM et DMARC), sinon les messages partent en spam.
# Absents → la déclaration est quand même enregistrée mais l'accusé ne part pas
# (le back-office le signale) ; avec une clé Stripe live, le paiement est refusé.
BREVO_API_KEY=xkeysib-xxxxxxxx
MAIL_FROM_EMAIL=support@xbz-esport.com
# Nom affiché de l'expéditeur (facultatif — défaut « XBZ Esport »).
MAIL_FROM_NAME=XBZ Esport


# === Bot Discord (facultatif) ================================================
# Sans ces URL, les formulaires fonctionnent et enregistrent en base : seule la
# notification Discord au staff est sautée.
BOT_RECRUTEMENT_URL=https://xbz-bot-url-server/recrutement
BOT_SUPPORT_URL=https://xbz-bot-url-server/support

# Reflet d'un changement de statut décidé dans le back-office sur le message
# Discord d'origine. Déduit automatiquement de BOT_RECRUTEMENT_URL si absent.
BOT_STATUT_URL=https://xbz-bot-url-server/statut

# Envoyé au bot dans l'en-tête `x-xbz-secret`.
# ⚠️  Doit être IDENTIQUE au BOT_SHARED_SECRET côté bot, sinon le bot répond 401.
BOT_SHARED_SECRET=change-me


# === Connexion Discord au back-office (obligatoire pour le bouton Discord) ===
# Seul un MEMBRE du serveur XBZ portant l'un des rôles ci-dessous peut se
# connecter via Discord. Non configuré → le bouton Discord refuse tout le monde
# (fail-safe) ; la connexion par mot de passe continue de fonctionner.
#
# Pour récupérer les ids : Discord › Paramètres › Avancés › Mode développeur,
# puis clic droit sur le serveur / sur un rôle › « Copier l'identifiant ».
DISCORD_GUILD_ID=000000000000000000

# Ids des rôles autorisés, séparés par des virgules (Administrateur, Fondateur).
DISCORD_STAFF_ROLE_IDS=000000000000000000,000000000000000000


# === Purge RGPD (recommandé) =================================================
# Protège /api/cron/purge (suppression des données > 24 mois). Vercel joint
# automatiquement `Authorization: Bearer $CRON_SECRET` au cron de vercel.json.
# ⚠️  Non défini → la purge refuse TOUT appel (sécurité) : à définir en prod.
CRON_SECRET=change-me-long-random


# === Monitoring (recommandé) =================================================
# Webhook du salon Discord qui reçoit les erreurs serveur et navigateur.
# Absent → les erreurs partent seulement dans les logs Vercel.
# 💡 Mets la MÊME valeur côté bot : toutes les alertes au même endroit.
DISCORD_ERROR_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx


# === Notifications des matchs (facultatif) ===================================
# Webhook du salon Discord qui reçoit les annonces de matchs : le digest
# quotidien (« les matchs du jour ») et le rappel « match bientôt ». Absent →
# les crons /api/cron/matchs tournent mais n'envoient rien (log seulement).
# Le crée dans Discord : salon › Modifier › Intégrations › Webhooks › Nouveau.
DISCORD_MATCHS_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx
# Fenêtre du rappel avant match, en minutes (facultatif — défaut 90).
MATCH_REMINDER_MINUTES=90


# === Tests end-to-end (facultatif) ===========================================
# Compte staff utilisé par Playwright pour tester la connexion au back-office
# (`npm run test:e2e`). Sans E2E_STAFF_EMAIL, ces tests sont simplement ignorés.
# En CI : à mettre dans GitHub › Settings › Secrets and variables › Actions.
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
